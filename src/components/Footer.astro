---
import { Icon } from 'astro-iconset/components';

const companyName = 'TF Stump Grinding';
const tagline = 'Professional Stump Grinding & Tree Services';
const address = 'Potsdam, NY';
const city = 'Serving St. Lawrence County';
// const googleMapsAddress = encodeURIComponent(`${address}, ${city}`);
// const googleMapsArea = encodeURIComponent('Your Service Area');

const phone = '(315) 212-6847';
const currentYear = new Date().getFullYear();
const hours = [
  { day: 'Mon-Fri', time: '8AM - 6PM' },
  { day: 'Saturday', time: '9AM - 2PM' },
  { day: 'Sunday', time: 'Closed' },
];

const quickLinks = [
  { label: 'Pricing', href: '#pricing' },
  { label: 'About', href: '#about' },
  { label: 'Reviews', href: '#testimonials' },
  { label: 'Contact', href: '#contact' },
  { label: 'Privacy Policy', href: '#' },
  { label: 'Terms of Service', href: '#' },
];

const socials = [
  {
    label: 'Facebook',
    icon: 'mdi:facebook',
    href: 'https://facebook.com',
  },
  {
    label: 'Instagram',
    icon: 'mdi:instagram',
    href: 'https://instagram.com',
  },
  {
    label: 'LinkedIn',
    icon: 'mdi:linkedin',
    href: 'https://linkedin.com',
  },
];

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'TF Stump Grinding',
  alternateName: 'TF Stump Grinding Service',
  description: 'Professional stump grinding for residential and business customers in Northern New York. Fully insured with free quotes.',
  telephone: '+13152126847',
  url: 'https://tfstumpgrinding.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Potsdam',
    addressRegion: 'NY',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'County',
    name: 'St. Lawrence County',
  },
  serviceType: 'Stump Grinding',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Stump Grinding Services',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Stump Grinding',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Tree Removal',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Full Service Clean Up',
        },
      },
    ],
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '3',
    bestRating: '5',
    worstRating: '1',
  },
  priceRange: '$$',
};
---

<footer id="footer" class="bg-[var(--color-accent-500)] text-white">
  <script
    type="application/ld+json"
    set:html={JSON.stringify(schemaData)}
  />

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    {/* Main grid */}
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {/* 1. Business Information */}
      <div>
        <h3 class="text-lg font-bold tracking-tight text-white">
          {companyName}
        </h3>
        <p class="mt-2 text-sm text-gray-300">{tagline}</p>
        <address class="mt-4 not-italic text-sm text-gray-300">
          {address}<br />
          <span class="text-gray-400">{city}</span>
        </address>
      </div>

      {/* 2. Contact Information */}
      <div>
        <h3 class="mb-4 text-lg font-bold tracking-tight text-white">
          Contact
        </h3>
        <a
          href={`tel:${phone.replace(/[() -]/g, '')}`}
          class="mb-4 inline-flex items-center gap-2 text-sm text-gray-300 transition-colors hover:text-[var(--color-accent-secondary-500)]"
        >
          <Icon name="material-symbols:call" class="h-4 w-4" />
          {phone}
        </a>
        <div class="mt-4">
          <h4 class="mb-2 flex items-center gap-1.5 text-sm font-semibold text-white">
            <Icon name="material-symbols:schedule" class="h-4 w-4" />
            Hours
          </h4>
          <ul class="space-y-1">
            {hours.map((h) => (
              <li class="text-sm text-gray-300">
                <span class="font-medium text-gray-200">{h.day}:</span>{' '}
                {h.time}
              </li>
            ))}
          </ul>
        </div>
      </div>

      {/* 3. Quick Links */}
      <div>
        <h3 class="mb-4 text-lg font-bold tracking-tight text-white">
          Quick Links
        </h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white transition-colors hover:text-[var(--color-accent-secondary-500)]"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Divider */}
    <hr class="mt-10 border-gray-700" />

    {/* Bottom bar */}
    <div class="mt-6 flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p class="text-sm text-gray-400">
        &copy; {currentYear} {companyName}. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        {/* Social icons */}
        <div class="flex items-center gap-3">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Follow us on ${s.label} (opens in new tab)`}
              class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-600 bg-gray-700/50 text-[var(--color-accent-secondary-500)] transition-all hover:border-[var(--color-accent-secondary-500)] hover:bg-gray-700 hover:text-[var(--color-accent-secondary-400)] hover:shadow-md"
            >
              <Icon name={s.icon} class="h-5 w-5" />
            </a>
          ))}
        </div>
        <div class="flex gap-3 text-sm text-gray-400">
          <a
            href="#"
            class="transition-colors hover:text-[var(--color-accent-secondary-500)]"
          >
            Privacy
          </a>
          <span aria-hidden="true">|</span>
          <a
            href="#"
            class="transition-colors hover:text-[var(--color-accent-secondary-500)]"
          >
            Terms
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
