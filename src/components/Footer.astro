---
import { Icon } from 'astro-iconset/components';

const companyName = 'BuildPro Contractors';
const tagline = 'Quality Craftsmanship, Built to Last';
const address = '1234 Builder Rd';
const city = 'Potsdam, NY 13676';
const googleMapsAddress = encodeURIComponent(`${address}, ${city}`);
const googleMapsArea = encodeURIComponent('Canton, Potsdam & Massena, NY');

const phone = '(315) 555-1212';
const hours = [
  { day: 'Mon-Fri', time: '8AM - 6PM' },
  { day: 'Saturday', time: '9AM - 2PM' },
  { day: 'Sunday', time: 'Closed' },
];

const quickLinks = [
  { label: 'About', href: '#about' },
  { label: 'Services', href: '#services' },
  { label: 'Testimonials', href: '#testimonials' },
  { label: 'Contact', href: '#contact' },
  { label: 'Privacy Policy', href: '#' },
  { label: 'Terms of Service', href: '#' },
];

const socials = [
  {
    label: 'Facebook',
    icon: 'mdi:facebook',
    href: 'https://facebook.com',
  },
  {
    label: 'Instagram',
    icon: 'mdi:instagram',
    href: 'https://instagram.com',
  },
  {
    label: 'LinkedIn',
    icon: 'mdi:linkedin',
    href: 'https://linkedin.com',
  },
];

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: companyName,
  tagline: tagline,
  address: {
    '@type': 'PostalAddress',
    streetAddress: address,
    addressLocality: 'Potsdam',
    addressRegion: 'NY',
    postalCode: '13676',
    addressCountry: 'US',
  },
  telephone: phone.replace(/[() -]/g, ''),
  openingHoursSpecification: hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek:
      h.day === 'Mon-Fri'
        ? ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday']
        : h.day === 'Saturday'
          ? 'Saturday'
          : 'Sunday',
    opens: h.time === 'Closed' ? null : h.time.split(' - ')[0],
    closes: h.time === 'Closed' ? null : h.time.split(' - ')[1],
  })),
};
---

<footer id="footer" class="bg-[var(--color-navy)]">
  <script
    type="application/ld+json"
    set:html={JSON.stringify(schemaData)}
  />

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    {/* Main grid */}
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {/* 1. Business Information */}
      <div>
        <h3 class="text-lg font-bold tracking-tight text-white">
          {companyName}
        </h3>
        <p class="mt-2 text-sm text-gray-300">{tagline}</p>
        <address class="mt-4 not-italic text-sm text-gray-300">
          {address}<br />
          {city}
        </address>
        <a
          href={`https://www.google.com/maps/search/?query=${googleMapsAddress}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-1.5 text-sm text-gray-300 transition-colors hover:text-[var(--color-amber)]"
          aria-label="View our location on Google Maps (opens in new tab)"
        >
          <Icon name="material-symbols:location-on" class="h-4 w-4" />
          <span class="sr-only">(opens in new tab)</span>
          View on Maps
        </a>
      </div>

      {/* 2. Contact Information */}
      <div>
        <h3 class="mb-4 text-lg font-bold tracking-tight text-white">
          Contact
        </h3>
        <a
          href={`tel:${phone.replace(/[() -]/g, '')}`}
          class="mb-4 inline-flex items-center gap-2 text-sm text-gray-300 transition-colors hover:text-[var(--color-amber)]"
        >
          <Icon name="material-symbols:call" class="h-4 w-4" />
          {phone}
        </a>
        <div class="mt-4">
          <h4 class="mb-2 flex items-center gap-1.5 text-sm font-semibold text-white">
            <Icon name="material-symbols:schedule" class="h-4 w-4" />
            Hours
          </h4>
          <ul class="space-y-1">
            {hours.map((h) => (
              <li class="text-sm text-gray-300">
                <span class="font-medium text-gray-200">{h.day}:</span>{' '}
                {h.time}
              </li>
            ))}
          </ul>
        </div>
      </div>

      {/* 3. Quick Links */}
      <div>
        <h3 class="mb-4 text-lg font-bold tracking-tight text-white">
          Quick Links
        </h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-gray-300 transition-colors hover:text-[var(--color-amber)]"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* 4. Service Area */}
      <div>
        <h3 class="mb-2 text-lg font-bold tracking-tight text-white">
          Service Area
        </h3>
        <p class="text-sm text-gray-300">
          Serving Canton, Potsdam &amp; Massena
        </p>
        <a
          href={`https://www.google.com/maps/search/?query=${googleMapsArea}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-1.5 text-sm text-gray-300 transition-colors hover:text-[var(--color-amber)]"
          aria-label="View our service area on Google Maps (opens in new tab)"
        >
          <Icon name="material-symbols:location-on" class="h-4 w-4" />
          <span class="sr-only">(opens in new tab)</span>
          View Service Area
        </a>
      </div>
    </div>

    {/* Divider */}
    <hr class="mt-10 border-gray-700" />

    {/* Bottom bar */}
    <div class="mt-6 flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p class="text-sm text-gray-400">
        &copy; 2026 {companyName}. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        {/* Social icons */}
        <div class="flex items-center gap-3">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Follow us on ${s.label} (opens in new tab)`}
              class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-600 bg-gray-700/50 text-[var(--color-amber)] transition-all hover:border-[var(--color-amber)] hover:bg-gray-700 hover:text-[var(--color-amber-light)] hover:shadow-md"
            >
              <Icon name={s.icon} class="h-5 w-5" />
            </a>
          ))}
        </div>
        <div class="flex gap-3 text-sm text-gray-400">
          <a
            href="#"
            class="transition-colors hover:text-[var(--color-amber)]"
          >
            Privacy
          </a>
          <span aria-hidden="true">|</span>
          <a
            href="#"
            class="transition-colors hover:text-[var(--color-amber)]"
          >
            Terms
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
