---
import { Icon } from 'astro-iconset/components';

const services = [
  {
    title: 'Home Renovation',
    description:
      'Transform your living spaces with our comprehensive home renovation services. From kitchen remodels to full home makeovers.',
  },
  {
    title: 'Commercial Buildouts',
    description:
      'Professional commercial space design and construction. We build offices, retail spaces, and restaurants that impress.',
  },
  {
    title: 'Roofing & Siding',
    description:
      'Protect your property with expert roofing and siding solutions. Quality materials and craftsmanship for lasting durability.',
  },
  {
    title: 'Electrical & Plumbing',
    description:
      'Licensed electrical and plumbing services for new construction, repairs, and upgrades. Safe and code-compliant work.',
  },
  {
    title: 'Custom Carpentry',
    description:
      'Beautiful custom woodwork crafted to your specifications. Cabinetry, trim, decks, and everything in between.',
  },
  {
    title: 'Project Management',
    description:
      'End-to-end project oversight ensuring your build stays on time and on budget. Clear communication from start to finish.',
  },
];

const iconMap = [
  'home-improvement-and-tools',
  'apartment',
  'roofing',
  'electrical-services',
  'carpenter',
  'assignment',
];
---

<section id="services" class="py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {/* Section header */}
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-[var(--color-navy)] sm:text-4xl">
        Our Services
      </h2>
      <p class="mt-4 text-lg text-gray-600">
        From concept to completion, we deliver quality craftsmanship across every trade.
      </p>
    </div>

    {/* Service cards grid */}
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service, index) => (
        <div
          class="group rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:border-[var(--color-amber)] hover:shadow-lg"
        >
          <div class="mb-4 inline-flex rounded-lg bg-[var(--color-navy)] p-3 text-[var(--color-amber)] transition-colors group-hover:bg-[var(--color-amber)] group-hover:text-[var(--color-navy-dark)]">
            <Icon name={`material-symbols:${iconMap[index]}`} class="h-8 w-8" />
          </div>
          <h3 class="mb-2 text-lg font-semibold text-[var(--color-navy)]">
            {service.title}
          </h3>
          <p class="text-sm leading-relaxed text-gray-600">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
