---
import { Icon } from 'astro-iconset/components';
---

<section id="contact" class="py-20 sm:py-28">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-[var(--color-accent-500)] sm:text-4xl">
        Contact & Customer Reviews
      </h2>
      <p class="mt-4 text-lg text-gray-600">
        Get in touch today for your free, No Hassle quote.
      </p>
      
      {/* Phone CTA button */}
      <div class="mt-8">
        <a
          href="tel:315-212-6847"
          class="inline-flex items-center rounded-full bg-[var(--color-accent-secondary-500)] px-8 py-4 text-lg font-semibold text-[var(--color-neutral-900)] transition-colors hover:bg-[var(--color-accent-secondary-400)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent-secondary-300)]"
          aria-label="Call TF Stump Grinding at 315-212-6847"
        >
          <Icon name="material-symbols:call" class="mr-2 h-6 w-6" />
          Tap to Call: 315-212-6847
        </a>
      </div>
    </div>
  </div>
</section>
