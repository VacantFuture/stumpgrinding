---

<section id="contact" class="bg-[var(--color-navy)] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      {/* Section header */}
      <div class="text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Get In Touch
        </h2>
        <p class="mt-4 text-lg text-gray-300">
          Ready to start your project? Fill out the form below and we'll get back to you within 24 hours.
        </p>
      </div>

      {/* Contact form */}
      <form
        action="#"
        method="POST"
        class="mt-10 rounded-2xl bg-white p-6 shadow-xl sm:p-10"
      >
        {/* Two-column row: First Name + Last Name */}
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label
              for="firstName"
              class="mb-1 block text-sm font-medium text-gray-700"
            >
              First Name
              <span class="ml-1 text-red-500" aria-hidden="true">*</span>
            </label>
            <input
              id="firstName"
              name="firstName"
              type="text"
              required
              class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 shadow-sm transition-colors focus:border-[var(--color-amber)] focus:outline-none focus:ring-2 focus:ring-[var(--color-amber)]/30"
              placeholder="First Name"
            />
          </div>
          <div>
            <label
              for="lastName"
              class="mb-1 block text-sm font-medium text-gray-700"
            >
              Last Name
              <span class="ml-1 text-red-500" aria-hidden="true">*</span>
            </label>
            <input
              id="lastName"
              name="lastName"
              type="text"
              required
              class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 shadow-sm transition-colors focus:border-[var(--color-amber)] focus:outline-none focus:ring-2 focus:ring-[var(--color-amber)]/30"
              placeholder="Last Name"
            />
          </div>
        </div>

        {/* Phone Number */}
        <div class="mt-5">
          <label
            for="phone"
            class="mb-1 block text-sm font-medium text-gray-700"
          >
            Phone Number
            <span class="ml-1 text-red-500" aria-hidden="true">*</span>
          </label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 shadow-sm transition-colors focus:border-[var(--color-amber)] focus:outline-none focus:ring-2 focus:ring-[var(--color-amber)]/30"
            placeholder="Phone Number"
          />
        </div>

        {/* Email Address */}
        <div class="mt-5">
          <label
            for="email"
            class="mb-1 block text-sm font-medium text-gray-700"
          >
            Email Address
            <span class="ml-1 text-red-500" aria-hidden="true">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 shadow-sm transition-colors focus:border-[var(--color-amber)] focus:outline-none focus:ring-2 focus:ring-[var(--color-amber)]/30"
            placeholder="Email Address"
          />
        </div>

        {/* Physical Address */}
        <div class="mt-5">
          <label
            for="address"
            class="mb-1 block text-sm font-medium text-gray-700"
          >
            Physical Address
            <span class="ml-1 text-red-500" aria-hidden="true">*</span>
          </label>
          <input
            id="address"
            name="address"
            type="text"
            required
            class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 shadow-sm transition-colors focus:border-[var(--color-amber)] focus:outline-none focus:ring-2 focus:ring-[var(--color-amber)]/30"
            placeholder="Physical Address"
          />
        </div>

        {/* Note / Message */}
        <div class="mt-5">
          <label
            for="message"
            class="mb-1 block text-sm font-medium text-gray-700"
          >
            Note / Message
            <span class="ml-1 text-red-500" aria-hidden="true">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 placeholder-gray-400 shadow-sm transition-colors focus:border-[var(--color-amber)] focus:outline-none focus:ring-2 focus:ring-[var(--color-amber)]/30"
            placeholder="Tell us about your project…"
          />
        </div>

        {/* Submit */}
        <div class="mt-6">
          <button
            type="submit"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[var(--color-amber)] px-8 py-3 text-base font-semibold text-[var(--color-navy-dark)] shadow-md transition-all hover:bg-[var(--color-amber-light)] hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-amber)] focus:ring-offset-2"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
            Send Message
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
