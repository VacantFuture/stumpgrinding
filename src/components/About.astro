---
import { Icon } from 'astro-iconset/components';
---

<section id="about" class="py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-[var(--color-accent-500)] sm:text-4xl">
        Stump Grinding
      </h2>
      <h3 class="mt-2 text-xl text-gray-600">
        Serving <span class="font-semibold">St. Lawrence County, NY</span> and the #NorthCountry
      </h3>
    </div>
    
    <div class="mt-10 text-center">
      <p class="mx-auto max-w-3xl text-lg leading-relaxed text-gray-700">
        We are a full service professional stump grinding operation. TF Stump Grinding
        provides quality service by using well maintained equipment, hard work and honest service.
        We offer services for residential and business clients.
      </p>
    </div>
  </div>
</section>
