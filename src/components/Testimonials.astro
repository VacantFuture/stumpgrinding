---
import { Icon } from 'astro-iconset/components';

const testimonials = [
  {
    quote:
      "BuildPro transformed our outdated kitchen into a stunning modern space. Their attention to detail and professionalism exceeded all our expectations. We couldn't be happier with the results!",
    name: 'Sarah & Tom Mitchell',
    project: 'Kitchen Renovation',
    stars: 5,
  },
  {
    quote:
      "We hired BuildPro for a complete commercial buildout of our new office. They delivered on time, on budget, and the quality was outstanding. Highly recommend for any commercial project.",
    name: 'James Rodriguez',
    project: 'Office Buildout',
    stars: 5,
  },
  {
    quote:
      "From the initial consultation to the final walkthrough, the entire experience was seamless. Our new roof and siding look fantastic and the crew was incredibly respectful of our property.",
    name: 'Linda & Mark Chen',
    project: 'Roofing & Siding',
    stars: 5,
  },
];
---

<section id="testimonials" class="py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {/* Section header */}
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-[#2B4C5E] sm:text-4xl">
        What Our Clients Say
      </h2>
      <p class="mt-4 text-lg text-gray-600">
        Don't just take our word for it — hear from homeowners and businesses we've worked with.
      </p>
    </div>

    {/* Testimonial cards */}
    <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t) => (
        <div class="flex h-full flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
          {/* Quote marks */}
          <Icon
            name="material-symbols:format-quote"
            class="mb-4 h-8 w-8 text-[#E2583E]/40"
          />
          <blockquote class="flex-1 text-sm leading-relaxed text-gray-600">
            "{t.quote}"
          </blockquote>
          {/* Author */}
          <div class="mt-6 flex items-center gap-3 border-t border-gray-100 pt-4">
            <div class="flex-shrink-0">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#2B4C5E] text-sm font-semibold text-[#E2583E]">
                {t.name.charAt(0)}
              </div>
            </div>
            <div>
              <p class="text-sm font-semibold text-[var(--color-accent-500)]">
                {t.name}
              </p>
              <p class="text-xs text-gray-500">{t.project}</p>
            </div>
            <div class="ml-auto flex gap-0.5">
              {Array.from({ length: t.stars }, (_, i) => (
                <Icon
                  name="material-symbols:star"
                  class="h-4 w-4 text-[var(--color-accent-secondary-500)]"
                />
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
