---
import { Icon } from 'astro-iconset/components';

const testimonials = [
  {
    quote: "We were highly satisfied with all aspects of the job.",
    name: 'Marty A',
  },
  {
    quote: "Very satisfied! He has fair prices and doesn't quit until the job is done completely even if it means making multiple trips to wait for bees to relocate!",
    name: 'Lory R.',
  },
  {
    quote: "Tim has outstanding equipment, he does a professional job at a very fair price.",
    name: 'Bob G',
  },
];
---

<section id="testimonials" class="py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {/* Section header */}
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-[var(--color-accent-500)] sm:text-4xl">
        What Our Clients Say
      </h2>
      <p class="mt-4 text-lg text-gray-600">
        Don't just take our word for it — hear from homeowners and businesses we've worked with.
      </p>
    </div>

    {/* Testimonial cards */}
    <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t) => (
        <div class="flex h-full flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
          <blockquote class="flex-1 text-sm leading-relaxed text-gray-600">
            "{t.quote}"
          </blockquote>
          <div class="mt-6 flex items-center gap-3 border-t border-gray-100 pt-4">
            <div>
              <p class="text-sm font-semibold text-[var(--color-accent-500)]">
                {t.name}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Google reviews link */}
    <div class="mt-10 text-center">
      <a
        href="https://g.page/tf-stump-grinding/review"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center rounded-full bg-[var(--color-success-100)] px-6 py-3 text-base font-medium text-[var(--color-neutral-900)] transition-colors hover:bg-[var(--color-success-200)] focus:outline-none focus:ring-2 focus:ring-[var(--color-success-300)]"
      >
        More 5 Star Reviews on Google
      </a>
    </div>
  </div>
</section>
