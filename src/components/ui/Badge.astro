---
export interface Props {
  variant?: 'default' | 'secondary' | 'destructive' | 'success' | 'warning' | 'info';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variants = {
  default: 'bg-accent-500 text-white hover:bg-accent-600',
  secondary: 'bg-muted text-muted-foreground hover:bg-muted/80',
  destructive: 'bg-destructive text-destructive-foreground hover:bg-destructive/90',
  success: 'bg-success-500 text-white hover:bg-success-600',
  warning: 'bg-warning-500 text-white hover:bg-warning-600',
  info: 'bg-info-500 text-white hover:bg-info-600',
};
---

<span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold transition-colors ${variants[variant]} ${className}`}>
  <slot />
</span>
---
