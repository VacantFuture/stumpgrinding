---
import { Icon } from 'astro-iconset/components';
import heroImage from '../images/Tfstump-main-background-v2.jpg';
---

<section
  class="relative flex min-h-screen w-full items-center justify-center"
  aria-label="Hero"
>
  {/* Background image - full width and height */}
  <div
    class="absolute inset-0 h-full w-full bg-cover bg-center bg-no-repeat"
    style={{ backgroundImage: `url(${heroImage.src})` }}
    aria-hidden="true"
  />

  {/* Navy overlay - matching original .bg-navy o-90 */}
  <div class="absolute inset-0 h-full w-full bg-[var(--color-accent-500)]/50" />

  {/* Content - centered vertically and horizontally */}
  <div class="relative z-10 flex flex-col items-center justify-center px-4 text-center sm:px-6">
    <h1 class="max-w-full bg-[var(--color-accent-500)]/90 px-4 py-3 font-heading text-3xl font-bold tracking-wide text-white sm:max-w-[80%] sm:text-4xl md:text-5xl lg:text-6xl">
      Serving the North Country
    </h1>
    
    <h2 class="mt-2 max-w-full bg-[var(--color-accent-500)]/90 py-3 text-2xl font-medium text-white sm:max-w-[80%] sm:text-3xl md:text-4xl">
      Fully Insured. Free Quotes.
    </h2>
    
    <blockquote class="mt-6">
      <a 
        href="tel:315-212-6847" 
        class="inline-flex items-center rounded-lg bg-[var(--color-accent-secondary-500)] px-6 py-3 text-lg font-medium text-[var(--color-neutral-900)] no-underline transition-colors hover:bg-[var(--color-accent-secondary-400)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent-secondary-300)]"
        aria-label="Call TF Stump Grinding at 315-212-6847"
      >
        <Icon name="material-symbols:call" class="mr-2 h-5 w-5" />
        Tap to Call: 315-212-6847
      </a>
    </blockquote>
  </div>
</section>
