---
import { Icon } from 'astro-iconset/components';

// Theme colors
const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#services', label: 'Services' },
  { href: '#testimonials', label: 'Testimonials' },
  { href: '#contact', label: 'Contact' },
];
const phoneNumber = '(555) 123-4567';
---

<nav
  class="fixed top-0 left-0 right-0 z-50 w-full bg-[var(--color-navy)] shadow-lg"
  aria-label="Main navigation"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      {/* Logo */}
      <a href="#" aria-label="Home" class="flex items-center gap-2">
        <Icon name="material-symbols:construction" class="h-8 w-8 text-[var(--color-amber)]" />
        <span class="text-xl font-bold text-white">BuildPro</span>
      </a>

      {/* Phone number (center, hidden on small screens) */}
      <a
        href={phoneNumber}
        class="hidden items-center gap-1.5 text-[var(--color-amber)] transition-colors hover:text-[var(--color-amber-light)] sm:flex"
      >
        <Icon name="material-symbols:call" class="h-4 w-4" />
        <span class="font-semibold">{phoneNumber}</span>
      </a>

      {/* Desktop nav links */}
      <div class="hidden items-center gap-1 md:flex">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 transition-colors hover:bg-[var(--color-navy-light)] hover:text-white"
          >
            {link.label}
          </a>
        ))}
        <a
          href={phoneNumber}
          class="ml-2 inline-flex items-center gap-1.5 rounded-md bg-[var(--color-amber)] px-4 py-2 text-sm font-semibold text-[var(--color-navy-dark)] transition-colors hover:bg-[var(--color-amber-light)]"
        >
          <Icon name="material-symbols:call" class="h-4 w-4" />
          Call Now
        </a>
      </div>

      {/* Mobile hamburger button */}
      <button
        type="button"
        id="mobile-menu-button"
        class="inline-flex items-center justify-center rounded-md p-2 text-gray-300 transition-colors hover:bg-[var(--color-navy-light)] hover:text-white focus:outline-none focus:ring-2 focus:ring-[var(--color-amber)] md:hidden"
        aria-expanded="false"
        aria-label="Toggle mobile menu"
      >
        <Icon name="material-symbols:menu" class="h-6 w-6" id="menu-icon-open" />
        <Icon name="material-symbols:close" class="hidden h-6 w-6" id="menu-icon-close" />
      </button>
    </div>

    {/* Mobile menu */}
    <div
      id="mobile-menu"
      class="hidden border-t border-gray-700 pb-4 md:hidden"
    >
      <div class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 transition-colors hover:bg-[var(--color-navy-light)] hover:text-white"
          >
            {link.label}
          </a>
        ))}
        <a
          href={phoneNumber}
          class="mt-2 inline-flex items-center justify-center gap-1.5 rounded-md bg-[var(--color-amber)] px-4 py-2 text-sm font-semibold text-[var(--color-navy-dark)] transition-colors hover:bg-[var(--color-amber-light)]"
        >
          <Icon name="material-symbols:call" class="h-4 w-4" />
          Call {phoneNumber}
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  menuButton?.addEventListener('click', () => {
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  // Close mobile menu when a link is clicked
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuButton?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
